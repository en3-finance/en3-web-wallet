{
  "name": "en3-web-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public sandbox reference web wallet for En3 white-label payment account flows.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --config apps/web-wallet/vite.config.ts",
    "build": "tsc -p apps/web-wallet/tsconfig.json && vite build --config apps/web-wallet/vite.config.ts",
    "test": "vitest run --config apps/web-wallet/vite.config.ts",
    "preview": "vite preview --host 0.0.0.0 --config apps/web-wallet/vite.config.ts"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
